---
// A figure with numbered markers on the image and a matching key underneath.
// marks: [{ x, y, label, note?, color? }] with x and y as percentages of the image.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Mark { x: number; y: number; label: string; note?: string; color?: string }
interface Props { src: ImageMetadata; alt: string; caption?: string; wide?: boolean; marks: Mark[] }
const { src, alt, caption, wide = false, marks } = Astro.props;
---
<figure class:list={['annotated', { wide }]}>
  <div class="annotated-stage">
    <Image src={src} alt={alt} widths={[640, 960, 1400, 1900]} sizes="(min-width: 980px) 58rem, 100vw" />
    {marks.map((m, i) => (
      <span class="mark" style={`left:${m.x}%;top:${m.y}%;${m.color ? `--mc:${m.color}` : ''}`} aria-hidden="true">{i + 1}</span>
    ))}
  </div>
  <ol class="marks-key">
    {marks.map((m) => (
      <li><strong>{m.label}</strong>{m.note && <span>{m.note}</span>}</li>
    ))}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
