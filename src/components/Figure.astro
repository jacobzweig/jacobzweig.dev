---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src?: ImageMetadata; alt?: string; caption?: string; wide?: boolean; slot?: string; needs?: string }
const { src, alt = '', caption, wide = false, needs } = Astro.props;
---
<figure class={wide ? 'wide' : undefined}>
  {src ? <Image src={src} alt={alt} widths={[640, 960, 1400, 1900]} sizes="(min-width: 980px) 58rem, 100vw" /> : (
    <div class="photo-slot">Photo needed: {needs ?? caption}</div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
