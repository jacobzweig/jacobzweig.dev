---
// Procedural cover for projects that don't have a photo yet:
// a few runs of addressable pixels mid-animation, tinted by the project's wire.
interface Props { seed: string; wire: string }
const { seed, wire } = Astro.props;
const hues: Record<string, number> = { red: 355, amber: 38, green: 158, blue: 216, violet: 266 };
const base = hues[wire] ?? 158;
let s = [...seed].reduce((a, ch) => (a * 31 + ch.charCodeAt(0)) >>> 0, 7);
const rand = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 2 ** 32);
const rows = 6, cols = 34, W = 1200, H = 800;
const px = 20, gx = (W - 120) / cols, gy = 96, top = (H - (rows - 1) * gy) / 2;
const dots = [];
for (let r = 0; r < rows; r++) {
  const phase = rand() * Math.PI * 2, freq = 0.18 + rand() * 0.22, shift = rand() * 70 - 20;
  for (let c = 0; c < cols; c++) {
    const v = Math.max(0, Math.sin(c * freq + phase)) ** 1.6;
    dots.push({
      x: 60 + c * gx + (gx - px) / 2, y: top + r * gy - px / 2,
      fill: `hsl(${(base + shift + c * 2.2) % 360} 92% ${14 + v * 52}%)`, v,
    });
  }
}
---
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Rows of addressable LED pixels" preserveAspectRatio="xMidYMid slice">
  <defs><filter id={`g-${seed}`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="14" /></filter></defs>
  <rect width={W} height={H} fill="#0a0f15" />
  {Array.from({ length: rows }, (_, r) => <rect x="40" y={top + r * gy - 17} width={W - 80} height="34" rx="6" fill="#141c25" />)}
  <g filter={`url(#g-${seed})`} opacity="0.9">
    {dots.filter((d) => d.v > 0.25).map((d) => <rect x={d.x - 6} y={d.y - 6} width={px + 12} height={px + 12} rx="8" fill={d.fill} />)}
  </g>
  {dots.map((d) => <rect x={d.x} y={d.y} width={px} height={px} rx="4" fill={d.fill} />)}
</svg>
